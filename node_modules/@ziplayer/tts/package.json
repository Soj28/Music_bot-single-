{
	"name": "@ziplayer/tts",
	"version": "1.0.0",
	"description": "Convert text to speech via Google Translate TTS (URLs) and Microsoft Edge TTS (audio buffer). Written in TypeScript.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"prepare": "npm run build",
		"prepublishOnly": "tsc -p ./ --outDir dist/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZiProject/tts.git"
	},
	"keywords": [
		"tts",
		"text-to-speech",
		"google-tts",
		"edge-tts",
		"microsoft-edge",
		"google-translate",
		"zibot"
	],
	"author": "Ziji",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ZiProject/tts/issues"
	},
	"homepage": "https://github.com/ZiProject/tts#readme",
	"dependencies": {
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/ws": "^8.5.14",
		"typescript": "^5.7.0"
	}
}
